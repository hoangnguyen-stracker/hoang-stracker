    "build": "npm run gen && heft build --clean && node scripts/fix-lib-commonjs-messages-type.js",
    "gen": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy globalVariable localStorage baseLocale --emit-ts-declarations --no-emit-git-ignore",
    "test": "npm run gen && heft test"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "~2.25.0",
